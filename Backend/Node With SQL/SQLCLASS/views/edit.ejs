<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Username</title>
</head>
<body>
    <h2>Edit Username: <%= user.email %></h2>
    <form method="post" action="/user/<%= user.id %>?_method=PATCH">
        <textarea name="newUsername"> <%= user.username %></textarea>
        <br>
        <input type="password" name="formPassword" placeholder="enter password">
        <br>
        <button>Edit</button>
    </form>
</body>
</html>